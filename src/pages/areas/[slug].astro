---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { areas } from "../../data/areas";
import { site } from "../../data/site";

export function getStaticPaths() {
  return areas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props;
const isPrimary = area.role === "primary";
---
<BaseLayout title={`${area.name} service area`} description={`${area.name}: ${area.angle}.`}>
  <h1>{isPrimary ? `${area.name} — our primary market` : `Enquiries from ${area.name}`}</h1>
  <p class="badge">{isPrimary ? "Primary market" : "Supporting area"}</p>
  <p>{area.angle}.</p>
  {isPrimary ? (
    <p>
      {site.brand} centres its service information on {area.name}. Browse our{" "}
      <a href="/services">services</a>, read our <a href="/articles">articles</a>, or start a{" "}
      <a href={site.enquiryPath}>general enquiry</a>.
    </p>
  ) : (
    <p>
      {area.name} is a confirmed supporting area of {site.brand}. Enquiries from {area.name} are
      handled through the same general enquiry path as {site.primaryMarket}, our primary market.
      This page does not represent a local office, on-call availability, or any response-time
      commitment.
    </p>
  )}
  <p>
    <a href="/services">View services</a> ·{" "}
    <a href={site.enquiryPath}>Start a general enquiry</a> ·{" "}
    <a href="/areas">All service areas</a>
  </p>
</BaseLayout>
