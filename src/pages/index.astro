---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import AreaCard from "../components/AreaCard.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { site } from "../data/site";
import { services } from "../data/services";
import { primaryArea, supportingAreas } from "../data/areas";
import { articles } from "../data/articles";

const orderedServices = [...services].sort((a, b) =>
  a.priority === b.priority ? a.name.localeCompare(b.name) : a.priority === "High" ? -1 : 1
);
const latestArticles = [...articles]
  .sort((a, b) => b.evidenceDate.localeCompare(a.evidenceDate))
  .slice(0, 3);
---
<BaseLayout title={`Pest and wildlife exclusion enquiries in ${site.primaryMarket}`}>
  <section class="hero">
    <h1>Pest and wildlife exclusion enquiries in {site.primaryMarket}</h1>
    <p>
      {site.brand} is an assessment- and enquiry-led service site centred on {primaryArea.name}.
      Every service starts with a general enquiry so scope can be discussed before anything is
      agreed.
    </p>
    <p><a class="cta" href={site.enquiryPath}>Start a general enquiry</a></p>
  </section>

  <section>
    <h2>Our primary market: {primaryArea.name}</h2>
    <p>
      {primaryArea.name} is the centre of everything on this site — our services, articles, and
      enquiry path are built around it.
    </p>
    <div class="grid">
      <AreaCard area={primaryArea} />
    </div>
  </section>

  <section>
    <h2>Services in {site.primaryMarket}</h2>
    <div class="grid">
      {orderedServices.map((s) => <ServiceCard service={s} />)}
    </div>
    <p><a href="/services">All services</a></p>
  </section>

  <section>
    <h2>Confirmed supporting areas</h2>
    <p>
      Beyond {primaryArea.name}, we accept enquiries from the confirmed supporting areas below.
      They are secondary to our {primaryArea.name} focus: enquiries from these areas use the same
      general enquiry path, and no local offices, availability, or travel commitments are implied.
    </p>
    <div class="grid">
      {supportingAreas.map((a) => <AreaCard area={a} />)}
    </div>
    <p><a href="/areas">All service areas</a></p>
  </section>

  <section>
    <h2>Latest articles</h2>
    <div class="grid">
      {latestArticles.map((a) => <ArticleCard article={a} />)}
    </div>
    <p><a href="/articles">All articles</a></p>
  </section>
</BaseLayout>
